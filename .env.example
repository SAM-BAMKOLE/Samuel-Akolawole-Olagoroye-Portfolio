# Copy to .env for local dev. On Vercel add the same two under Project → Settings → Environment Variables.
# Server-only: these are never sent to the browser.

# The "Web app" URL you get after deploying the Apps Script (apps-script/Code.gs)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# A long random string. Must match the SECRET script property in Apps Script exactly.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPS_SCRIPT_SECRET=
