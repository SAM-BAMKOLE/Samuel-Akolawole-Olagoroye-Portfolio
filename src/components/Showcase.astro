---
import { showcase } from "@/data/content";
---

<!--
  Full-bleed image/video section. The tall wrapper gives scroll distance; the frame is
  sticky, starts as an inset rounded card and expands to the full viewport as you scroll.
-->
<section id="about" class="showcase relative h-[175svh] bg-paper">
  <div class="sticky top-0 h-svh">
    <div class="showcase-frame absolute inset-0 overflow-hidden bg-ink" style="clip-path: inset(0 0 0 0)">
      {showcase.video ? (
        <video
          class="showcase-media absolute inset-0 h-full w-full object-cover"
          src={showcase.video}
          poster={showcase.image}
          autoplay muted loop playsinline
        ></video>
      ) : (
        <img class="showcase-media absolute inset-0 h-full w-full object-cover" src={showcase.image} alt={showcase.alt} loading="lazy" />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/15 to-black/25"></div>

      <div class="showcase-copy absolute inset-x-0 bottom-0 text-white">
        <div class="wrap grid items-end gap-10 pb-10 md:grid-cols-12 md:pb-14">
          <div class="md:col-span-7">
            <p class="eyebrow mb-5 !text-white/70">{showcase.eyebrow}</p>
            <h2 class="display h-xl !text-[clamp(3rem,8vw,8.5rem)]">{showcase.title}</h2>
          </div>
          <div class="md:col-span-5">
            <p class="max-w-md text-lg leading-snug text-white/85 md:text-xl">{showcase.text}</p>
            <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-white/25 pt-5 text-sm">
              {showcase.facts.map((f) => (
                <div>
                  <dt class="eyebrow !text-white/55">{f.label}</dt>
                  <dd class="mt-1.5 leading-snug">{f.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
